fn os_sleep(millis: u64) -> u64 {
  let stall = *(os_kernel().system.boot_services + 248);
  efi_call1(stall, millis * 1000);
  return OK;
}

fn os_stat(name: &u64, length: u64) -> u64 {
  let process = os_kernel().current_process;
  if process_contains_buffer(process, name, length) == FALSE {
    return error_result(INVALID_ARGUMENT);
  }
  let disk = os_kernel().disk;
  let file_block = disk_find_file(disk, name, length, null);
  if file_block == null { return error_result(NOT_FOUND); }
  return disk_get_file_size(disk, file_block);
}

const STANDARD_INPUT: u64 = 0;
const STANDARD_OUTPUT: u64 = 1;
const KEYBOARD: u64 = 2;
const GPU: u64 = 3;
const FIRST_FILE_STREAM_ID: u64 = 4;

fn process_get_file_stream(self: &Process, stream_id: u64) -> &FileStream {
  let stream = self.file_streams;
  let id = FIRST_FILE_STREAM_ID;
  while stream != null && id != stream_id {
    stream = stream.next;
    id = id + 1;
  }
  return stream;
}

fn process_get_unused_file_stream(self: &Process, stream_id: &u64) -> &FileStream {
  let stream_ptr = &self.file_streams;
  let stream = *stream_ptr;
  *stream_id = FIRST_FILE_STREAM_ID;
  while stream != null && stream.mode != MODE_UNUSED {
    stream_ptr = &stream.next;
    stream = *stream_ptr;
    *stream_id = *stream_id + 1;
  }
  let kernel = os_kernel();
  if stream == null && kernel.heap + sizeof(FileStream) <= kernel.heap_limit {
    stream = kernel.heap as &FileStream;
    kernel.heap = kernel.heap + sizeof(FileStream);
    stream.next = null;
    stream.mode = MODE_UNUSED;
    stream.file_block = 0;
    *stream_ptr = stream;
  }
  return stream;
}

fn process_can_open(self: &Process, file_block: u64, mode: u64) -> u64 {
  let process = self;
  let stream: &FileStream = null;
  while process != null {
    stream = process.file_streams;
    while stream != null {
      if stream.file_block == file_block && stream.mode != MODE_LIST {
        if stream.mode == MODE_WRITE || mode == MODE_WRITE {
          return FALSE;
        }
      }
      stream = stream.next;
    }
    process = process.parent;
  }
  return TRUE;
}

fn os_open(name: &u64, length: u64, mode: u64) -> u64 {
  let process = os_kernel().current_process;
  if process_contains_buffer(process, name, length) == FALSE ||
      mode != MODE_READ && mode != MODE_WRITE {
    return error_result(INVALID_ARGUMENT);
  }
  let stream_id = 0;
  let stream = process_get_unused_file_stream(process, &stream_id);
  if stream == null { return error_result(OUT_OF_MEMORY); }
  let disk = os_kernel().disk;
  disk_read_block_buffer(disk, SUPER_BLOCK);
  let file_block = disk.block_buffer.next_file;
  let status = OK;
  if length == 0 {
    if mode != MODE_READ { status = INVALID_ARGUMENT; }
    mode = MODE_LIST;
  } else {
    file_block = disk_find_file(disk, name, length, null);
    if file_block == 0 {
      if mode == MODE_READ {
        status = NOT_FOUND;
      } else {
        status = disk_create_file(disk, name, length, &file_block);
      }
    } else if process_can_open(process, file_block, mode) == TRUE {
      if mode == MODE_READ {
        disk_read_block_buffer(disk, file_block);
        stream.current_offset = 24 + disk.block_buffer.name_length;
      } else {
        disk_clear_file(disk, file_block);
      }
    } else {
      status = INVALID_STATE;
    }
  }
  if status != OK { return error_result(status); }
  stream.mode = mode;
  stream.file_block = file_block;
  stream.current_block = file_block;
  return stream_id;
}

fn min(x: u64, y: u64) -> u64 {
  if x < y { return x; } else { return y; }
}

fn os_read(stream_id: u64, buffer: &u64, size: u64) -> u64 {
  let kernel = os_kernel();
  let process = kernel.current_process;
  if size == 0 || process_contains_buffer(process, buffer, size) == FALSE {
    return error_result(INVALID_ARGUMENT);
  }
  let i = 0;
  if stream_id < FIRST_FILE_STREAM_ID {
    if stream_id == STANDARD_INPUT {
      *buffer = keyboard_wait_char(kernel.keyboard);
      return 1;
    } else if stream_id == KEYBOARD {
      *buffer = keyboard_get_char(kernel.keyboard);
      return 1;
    } else {
      return error_result(INVALID_STATE);
    }
  }
  let stream = process_get_file_stream(process, stream_id);
  if stream == null || stream.mode == MODE_UNUSED {
    return error_result(NOT_FOUND);
  }
  let disk = kernel.disk;
  if stream.mode == MODE_LIST {
    if stream.file_block == 0 { return 0; }
    disk_read_block_buffer(disk, stream.file_block);
    size = min(size, disk.block_buffer.name_length);
    mem_copy_non_overlapping(&disk.block_buffer.name, buffer, size);
    stream.file_block = disk.block_buffer.next_file;
    return size;
  }
  if stream.mode != MODE_READ { return error_result(INVALID_STATE); }
  return size - disk_read_file(disk, &stream.current_block, &stream.current_offset, buffer, size);
}

fn os_write(stream_id: u64, buffer: &u64, size: u64) -> u64 {
  let kernel = os_kernel();
  let process = kernel.current_process;
  if process_contains_buffer(process, buffer, size) == FALSE {
    return error_result(INVALID_ARGUMENT);
  }
  let i = 0;
  if stream_id < FIRST_FILE_STREAM_ID {
    if stream_id == STANDARD_OUTPUT {
      size = min(size, process.output_limit - *process.output_p);
      mem_copy_non_overlapping(buffer, *process.output_p, size);
      *process.output_p = *process.output_p + size;
      return size;
    } else if stream_id == GPU {
      while i + 2 < size {
        gpu_set_register(kernel.gpu, load8(buffer + i), load16(buffer + i + 1));
        i = i + 3;
      }
      return i;
    } else {
      return error_result(INVALID_STATE);
    }
  }
  let stream = process_get_file_stream(process, stream_id);
  if stream == null || stream.mode == MODE_UNUSED {
    return error_result(NOT_FOUND);
  }
  if stream.mode != MODE_WRITE { return error_result(INVALID_STATE); }
  let status = disk_write_file(kernel.disk, &stream.current_block, buffer, size);
  if status != OK { return error_result(status); }
  return size;
}

fn os_close(stream_id: u64) -> u64 {
  let process = os_kernel().current_process;
  let stream = process_get_file_stream(process, stream_id);
  if stream == null || stream.mode == MODE_UNUSED {
    return error_result(NOT_FOUND);
  }
  stream.mode = MODE_UNUSED;
  stream.file_block = 0;
  return OK;
}

fn os_delete(name: &u64, length: u64) -> u64 {
  let process = os_kernel().current_process;
  if process_contains_buffer(process, name, length) == FALSE {
    return error_result(INVALID_ARGUMENT);
  }
  let disk = os_kernel().disk;
  let previous_file_block = 0;
  let file_block = disk_find_file(disk, name, length, &previous_file_block);
  if file_block == 0 { return error_result(NOT_FOUND); }
  if process_can_open(process, file_block, MODE_WRITE) == FALSE {
    return error_result(INVALID_STATE);
  }
  let stream: &FileStream = null;
  while process != null {
    stream = process.file_streams;
    while stream != null {
      if stream.mode == MODE_LIST && stream.file_block == file_block {
        disk_read_block_buffer(disk, file_block);
        stream.file_block = disk.block_buffer.next_file;
      }
      stream = stream.next;
    }
    process = process.parent;
  }
  disk_delete_file(disk, file_block, previous_file_block);
  return OK;
}

fn os_reboot() -> u64 {
  let reset_system = *(os_kernel().system.runtime_services + 104);
  return efi_call4(reset_system, 0, 0, 0, 0);
}