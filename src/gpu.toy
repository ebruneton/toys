const BLACK: u64 = 0;
const BLUE: u64 = 1;
const GREEN: u64 = 2;
const CYAN: u64 = 3;
const RED: u64 = 4;
const MAGENTA: u64 = 5;
const LIGHTGRAY: u64 = 7;
const YELLOW: u64 = 14;

fn gpu_set_register(id: u64, value: u64) {
  let buffer = value << 8 | id;
  write(GPU, &buffer, 3);
}

fn gpu_switch_buffer() {
  gpu_set_register(5 /*Switch Buffer*/, 0);
}

fn gpu_clear_screen() {
  gpu_set_register(4 /*Clear Screen*/, 0);
}

fn gpu_set_cursor(col: u64, row: u64) {
  gpu_set_register(1 /*Set Cursor*/, row << 8 | col);
}

fn gpu_draw_cursor(col: u64, row: u64) {
  gpu_set_register(2 /*Draw Cursor*/, row << 8 | col);
}

fn gpu_set_color(color: u64) {
  gpu_set_register(3 /*Color*/, color);
}

fn gpu_draw_char(c: u64) {
  gpu_set_register(0 /*Draw Char*/, c);
}
