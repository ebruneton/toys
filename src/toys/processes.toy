const MODE_UNUSED: u64 = 0;
const MODE_LIST: u64 = 'l';
const MODE_READ: u64 = 'r';
const MODE_WRITE: u64 = 'w';

struct FileStream {
  next: &FileStream,
  mode: u64,
  file_block: u64,
  current_block: u64,
  current_offset: u64
}

struct Process {
  parent: &Process,
  begin: &u64,
  end: &u64,
  saved_r8: u64,
  saved_r9: u64,
  saved_stack_pointer: u64,
  saved_return_address: u64,
  file_streams: &FileStream,
  output_p: &&u64,
  output_limit: &u64
}

struct Kernel {
  stack_pointer: u64,
  heap: &u64,
  heap_limit: &u64,
  mem_limit: &u64,
  keyboard: &SimpleTextInputProtocol,
  gpu: &Gpu,
  disk: &Disk,
  system: &SystemTable,
  current_process: &Process,
  spawn: u64,
  exit: u64,
  sleep: u64,
  stat: u64,
  open: u64,
  read: u64,
  write: u64,
  close: u64,
  delete: u64,
  reboot: u64
}

fn os_kernel() -> &Kernel;

fn get_control_register3() -> &u64    [ 65, 15, 32, 216, /*mov r8,cr3*/ 195 /*ret*/ ]
fn set_control_register3(value: &u64) [ 65, 15, 34, 216, /*mov cr3,r8*/ 195 /*ret*/ ]

fn not(x: u64) -> u64 { return 0 - (x + 1); }

fn set_page_entry_user_mode(entry_p: &u64, enabled: u64) -> &u64 {
  if enabled == 1 {
    *entry_p = *entry_p | 4;
  } else {
    *entry_p = *entry_p & not(4);
  }
  *entry_p = (*entry_p) & not(1 << 63);
  const PAGE_PHYSICAL_ADDRESS_MASK: u64 = 4503599627366400;
  return (*entry_p & PAGE_PHYSICAL_ADDRESS_MASK) as &u64;
}

fn set_page_user_mode(address: u64, enabled: u64) {
  const OFFSET_MASK: u64 = 4088;
  let table4 = get_control_register3();
  let table3 = set_page_entry_user_mode(table4 + ((address >> 36) & OFFSET_MASK), enabled);
  let table2 = set_page_entry_user_mode(table3 + ((address >> 27) & OFFSET_MASK), enabled);
  let table1 = set_page_entry_user_mode(table2 + ((address >> 18) & OFFSET_MASK), enabled);
  set_page_entry_user_mode(table1 + ((address >> 9) & OFFSET_MASK), enabled);
}

fn set_pages_user_mode(begin_page: &u64, end_page: &u64, enabled: u64) {
  while begin_page < end_page {
    set_page_user_mode(begin_page as u64, enabled);
    begin_page = begin_page + 4096;
  }
  set_control_register3(get_control_register3());  /* Invalidate the TLB cache. */
}

fn os_set_current_process(kernel: &Kernel, process: &Process) {
  if process.parent != null {
    set_pages_user_mode(process.parent.begin, process.parent.end, 0);
  }
  set_pages_user_mode(process.begin, process.end, 1);
  kernel.current_process = process;
}

const FALSE: u64 = 0;
const TRUE: u64 = 1;

fn process_contains_buffer(self: &Process, ptr: &u64, size: u64) -> u64 {
  if ptr < self.begin || ptr >= self.end { return FALSE; }
  if size > self.end - ptr { return FALSE; }
  return TRUE;
}

fn os_spawn(dst: &u64, name: &u64, name_length: u64,
    args: &u64, args_length: u64, output_p: &&u64) -> u64 {
  let kernel = os_kernel();
  if sizeof(Process) > kernel.heap_limit - kernel.heap {
    return error_result(OUT_OF_MEMORY);
  }
  let begin = (((dst as u64 + 4095) >> 12) << 12) as &u64;
  let end = kernel.mem_limit;
  let parent = kernel.current_process;
  if parent != null {
    end = ((parent.saved_stack_pointer as u64 >> 12) << 12) as &u64;
    if end < begin || begin < parent.begin ||
        process_contains_buffer(parent, name, name_length) == FALSE ||
        process_contains_buffer(parent, args, args_length) == FALSE {
      return error_result(INVALID_ARGUMENT);
    }
    if args + args_length > begin && args < end {
      return error_result(INVALID_ARGUMENT);
    }
    if process_contains_buffer(parent, output_p as &u64, 8) == FALSE ||
        *output_p < parent.begin || *output_p > dst {
      return error_result(INVALID_ARGUMENT);
    }
  }
  let disk = kernel.disk;
  let file_block = disk_find_file(disk, name, name_length, null);
  if file_block == 0 { return error_result(NOT_FOUND); }
  let code_size = disk_get_file_size(disk, file_block);
  if code_size > end - begin {
    return error_result(OUT_OF_MEMORY);
  }
  const MIN_STACK_SIZE: u64 = 1024;
  let heap = begin + code_size;
  let heap_limit = end - MIN_STACK_SIZE;
  if heap_limit < heap + 8 || args_length > heap_limit - heap - 8 {
    return error_result(OUT_OF_MEMORY);
  }
  let offset = 24 + name_length;
  disk_read_file(disk, &file_block, &offset, begin, code_size);
  *heap = args_length;
  mem_copy_non_overlapping(args, heap + 8, args_length);
  let process = kernel.heap as &Process;
  kernel.heap = kernel.heap + sizeof(Process);
  process.parent = parent;
  process.begin = begin;
  process.end = end;
  process.saved_r8 = heap as u64;
  process.saved_r9 = heap_limit as u64;
  process.saved_stack_pointer = end as u64;
  process.saved_return_address = begin as u64;
  process.file_streams = null;
  process.output_p = output_p;
  process.output_limit = dst;
  os_set_current_process(kernel, process);
  return OK;
}

fn os_exit(result: u64) -> u64 {
  let kernel = os_kernel();
  let process = kernel.current_process;
  if process.parent == null { return error_result(INVALID_STATE); }
  if result >= (1 << 56) { return error_result(INVALID_ARGUMENT); }
  kernel.heap = process as &u64;
  process = process.parent;
  process.saved_r8 = result;
  os_set_current_process(kernel, process);
  return OK;
}
